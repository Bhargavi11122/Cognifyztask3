<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1, initial-scale=1.0">
    <title>Task3-Responsive Design</title>
    <link href="https;//cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-5">
        <div class="container">
            <span class="navbar-brand mb-0 h1">Cognifyz Internship Dashboard</span>
        </div>
    </nav>
    <div  class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-5 mb-4">
                <div class="card shadow-sm p-4">
                    <h3 class="card-title text-center text-primary mb-4">Task 3- User Registration</h3>
                    <form action="/submit" method="POST">
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">ENTER YOUR NAME:</label>
                             <input type="text" name="username" class="form-control" placeholder="Type Here">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Submit</button>
                    </form>
                    <% if(typeof error!=='undefined'){%>
                        <div class="alert alert-danger mt-3 text-center" role="alert">
                            <%= error %>
                        </div> 
                    <% } %>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-5">
                <div class="card shadow-sm p-4">
                    <h3 class="card-title text-center text-success mb-4">users</h3>
                    <% if (typeof allUsers !=='undefined' && allUsers.length>0) { %>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover border">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>User Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% allUsers.forEach((user,index)=>{%>
                                        <tr>
                                            <td><%= index+1 %></td>
                                            <td><%= user %></td>
                                        </tr>  
                                    <% }) %>
                                </tbody>
                            </table>
                        </div> 
                    <% } else { %>
                        <p class="text-muted text-center">NO USERS AT ALL</p>
                    <% } %>    
                </div>
            </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>